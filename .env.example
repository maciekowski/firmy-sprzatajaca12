# ---------------------------------------------------------------------------
# ServiceFlow — przykładowa konfiguracja środowiska.
# Skopiuj do .env i uzupełnij. NIE commituj prawdziwych sekretów.
# ---------------------------------------------------------------------------

# Baza danych (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/serviceflow?schema=public"
PGPORT=5433
PGUSER=postgres
PGDATABASE=serviceflow
PGDATA_DIR=.pgdata

# Podstawowe
APP_URL="http://localhost:3000"
APP_SECRET="zmień-na-długi-losowy-ciąg-znaków"
NODE_ENV="development"

# Lokalny storage plików (poza repozytorium)
STORAGE_DIR=".storage"

# Cron / worker (endpoint /api/cron/run)
CRON_SECRET="zmień-na-inny-długi-losowy-ciąg"

# ---------------------------------------------------------------------------
# Poczta wychodząca (SMTP). Bez tego system NIE wysyła maili —
# wiadomości są zapisywane ze statusem SKIPPED_NO_PROVIDER (brak udawania).
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="ServiceFlow <no-reply@twojadomena.pl>"

# SMS — opcjonalnie. Brak providera = brak wysyłki (status SKIPPED_NO_PROVIDER).
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_FROM=""

# ---------------------------------------------------------------------------
# Stripe (subskrypcje ServiceFlow). Brak kluczy = płatności NIEAKTYWNE.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Dostawca AI (opcjonalny). Bez klucza działa deterministyczny silnik regułowy
# i odpowiedzi oparte na rzeczywistych danych z bazy.
# ---------------------------------------------------------------------------
AI_PROVIDER=""            # openai | anthropic | none
AI_MODEL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
